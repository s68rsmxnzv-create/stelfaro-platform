{
  "name": "stelfaro-print-agent",
  "version": "0.2.0-dev",
  "private": true,
  "description": "Local ESC/POS print agent for Stelfaro, Alefactura, and Fiscal Import labs.",
  "type": "module",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "package:win": "npx @yao-pkg/pkg . --targets node20-win-x64 --output dist/stelfaro-print-agent.exe"
  },
  "engines": {
    "node": ">=20"
  }
}
